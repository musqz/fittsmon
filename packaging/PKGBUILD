# Maintainer: Eric Bakker <musqz at mf dot com>
pkgname=fittsmon
pkgver=1.2.0
pkgrel=1
pkgdesc="Lightweight X11/Wayland utility to bind mouse actions to screen corners and edges (multi-monitor)"
arch=('x86_64')
url="https://github.com/musqz/fittsmon"
license=('GPL-2.0-or-later')
depends=('glib2' 'libx11' 'libxcb' 'wayland')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('bb75f606bb57ddccb24e7a630661501f009a8bf02ee3f60d8c45d2df2f943426')

build() {
    cd "${pkgname}-${pkgver}"
    make
}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR="${pkgdir}" PREFIX=/usr install
}
